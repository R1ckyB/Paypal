# ==========================================================
# FacturaBot - PayPal AI Collection Agent (Environment Variables)
# Copy this file to ".env" and fill in your credentials.
# NEVER commit your real ".env" file to the repository.
# ==========================================================

# --- PayPal Developer Platform (Sandbox: https://developer.paypal.com/dashboard/applications) ---
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
# sandbox -> https://api-m.sandbox.paypal.com | live -> https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID registered in PayPal Developer Dashboard (for signature verification)
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# --- AI / LLM Configuration (Optional - automatic smart fallback if omitted) ---
# Provide EITHER a Google Gemini API key OR an OpenAI-compatible API key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Database ---
# Local: sqlite:///paypal_agent.db | Render Postgres: postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///paypal_agent.db

# --- Server & UI ---
APP_ENV=development
PORT=8080
DEFAULT_LANG=en
