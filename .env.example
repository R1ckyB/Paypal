# ==========================================================
# PayPal Collection Agent - Variables de entorno
# Copia este archivo a ".env" y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ==========================================================

# --- PayPal (Sandbox: https://developer.paypal.com/dashboard/applications) ---
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
# sandbox -> https://api-m.sandbox.paypal.com | live -> https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# ID del webhook registrado en PayPal (para verificar firmas)
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# --- Base de datos ---
# Local: sqlite:///paypal_agent.db | Render Postgres: postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///paypal_agent.db

# --- Servidor ---
APP_ENV=development
PORT=8000
