{
  "info": {
    "name": "FacturaBot - PayPal AI Collection Agent (Hackathon Collection)",
    "_postman_id": "b6f1c2a4-7d3e-4e0a-9c1f-paypal-agent-001",
    "description": "Public Postman Collection for FacturaBot (PayPal AI Hackathon).\n\nIncludes:\n1. FacturaBot Backend & AI Agent REST Endpoints (`/api/health`, `/api/invoices`, `/api/agent/chat`, `/api/invoices/:id/remind`, `/api/invoices/:id/approve-plan`, `/api/invoices/:id/pay`).\n2. Simulated PayPal Webhooks (`/api/paypal-webhook`).\n3. Official PayPal Sandbox OAuth2 & Invoicing v2 API (`generate-next-invoice-number`, `invoices`, `send`, `remind`, `payments`, `cancel`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "backend_url", "value": "http://localhost:8080" },
    { "key": "paypal_base_url", "value": "https://api-m.sandbox.paypal.com" },
    { "key": "client_id", "value": "" },
    { "key": "client_secret", "value": "" },
    { "key": "access_token", "value": "" },
    { "key": "invoice_id", "value": "INV-2026-001" },
    { "key": "invoice_number", "value": "" },
    { "key": "client_email", "value": "pagos@globex.com" }
  ],
  "item": [
    {
      "name": "1. FacturaBot Backend & AI Agent (Render / Local)",
      "item": [
        {
          "name": "Health Check & AI Engine Status",
          "request": { "method": "GET", "url": "{{backend_url}}/api/health" }
        },
        {
          "name": "List Invoices (SQLite + PayPal Sync)",
          "request": { "method": "GET", "url": "{{backend_url}}/api/invoices" }
        },
        {
          "name": "AI Agent Chat - Request Installment Plan (Triggers HITL)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{backend_url}}/api/agent/chat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client\": \"Globex\",\n  \"message\": \"We cannot pay the full amount right now, can we split it into 2 installments?\",\n  \"amount\": 8200.0,\n  \"lang\": \"en\"\n}"
            }
          }
        },
        {
          "name": "Human-In-The-Loop - Approve Partial Plan in PayPal",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{backend_url}}/api/invoices/{{invoice_id}}/approve-plan",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payments\": 2\n}"
            }
          }
        },
        {
          "name": "Trigger PayPal Invoice Reminder",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{backend_url}}/api/invoices/{{invoice_id}}/remind"
          }
        },
        {
          "name": "Record PayPal Invoice Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{backend_url}}/api/invoices/{{invoice_id}}/pay",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 8200.0\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Simulated Webhooks (PayPal -> FacturaBot Backend)",
      "item": [
        {
          "name": "INVOICING.INVOICE.PAID",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{backend_url}}/api/paypal-webhook",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"WH-SIM-PAID-001\",\n  \"event_version\": \"1.0\",\n  \"create_time\": \"{{$isoTimestamp}}\",\n  \"resource_type\": \"invoices\",\n  \"event_type\": \"INVOICING.INVOICE.PAID\",\n  \"summary\": \"An invoice was paid\",\n  \"resource\": {\n    \"id\": \"{{invoice_id}}\",\n    \"status\": \"PAID\",\n    \"amount\": { \"currency_code\": \"USD\", \"value\": \"8200.00\" }\n  }\n}"
            }
          }
        },
        {
          "name": "INVOICING.INVOICE.CANCELLED",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{backend_url}}/api/paypal-webhook",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"WH-SIM-CANCEL-001\",\n  \"event_type\": \"INVOICING.INVOICE.CANCELLED\",\n  \"resource_type\": \"invoices\",\n  \"resource\": { \"id\": \"{{invoice_id}}\", \"status\": \"CANCELLED\" }\n}"
            }
          }
        },
        {
          "name": "INVOICING.INVOICE.REFUNDED",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{backend_url}}/api/paypal-webhook",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"WH-SIM-REFUND-001\",\n  \"event_type\": \"INVOICING.INVOICE.REFUNDED\",\n  \"resource_type\": \"invoices\",\n  \"resource\": { \"id\": \"{{invoice_id}}\", \"status\": \"REFUNDED\" }\n}"
            }
          }
        },
        {
          "name": "Invalid Payload (Expects HTTP 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{backend_url}}/api/paypal-webhook",
            "body": { "mode": "raw", "raw": "esto no es json" }
          }
        }
      ]
    },
    {
      "name": "3. PayPal Sandbox - OAuth 2.0",
      "item": [
        {
          "name": "Get Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.access_token) pm.collectionVariables.set('access_token', r.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{client_id}}" },
                { "key": "password", "value": "{{client_secret}}" }
              ]
            },
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [{ "key": "grant_type", "value": "client_credentials" }]
            },
            "url": "{{paypal_base_url}}/v1/oauth2/token"
          }
        }
      ]
    },
    {
      "name": "4. PayPal Sandbox - Invoicing v2 API",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{access_token}}" }]
      },
      "item": [
        {
          "name": "Generate Invoice Number",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('invoice_number', pm.response.json().invoice_number);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paypal_base_url}}/v2/invoicing/generate-next-invoice-number"
          }
        },
        {
          "name": "Create Draft Invoice (with Partial Payment Enabled)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "const id = r.id || (r.href || '').split('/').pop();",
                  "if (id) pm.collectionVariables.set('invoice_id', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Prefer", "value": "return=representation" }
            ],
            "url": "{{paypal_base_url}}/v2/invoicing/invoices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"detail\": {\n    \"invoice_number\": \"{{invoice_number}}\",\n    \"currency_code\": \"USD\",\n    \"note\": \"Managed by FacturaBot AI - Partial Payment Plan Enabled.\",\n    \"payment_term\": { \"term_type\": \"NET_30\" }\n  },\n  \"primary_recipients\": [\n    { \"billing_info\": { \"email_address\": \"{{client_email}}\" } }\n  ],\n  \"items\": [\n    {\n      \"name\": \"Enterprise Consulting Services\",\n      \"quantity\": \"1\",\n      \"unit_amount\": { \"currency_code\": \"USD\", \"value\": \"8200.00\" }\n    }\n  ],\n  \"configuration\": {\n    \"allow_tip\": false,\n    \"partial_payment\": { \"allow_partial_payment\": true, \"minimum_amount_due\": { \"currency_code\": \"USD\", \"value\": \"4100.00\" } }\n  }\n}"
            }
          }
        },
        {
          "name": "Send Invoice",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paypal_base_url}}/v2/invoicing/invoices/{{invoice_id}}/send",
            "body": { "mode": "raw", "raw": "{\n  \"send_to_invoicer\": true\n}" }
          }
        },
        {
          "name": "Get Invoice",
          "request": { "method": "GET", "url": "{{paypal_base_url}}/v2/invoicing/invoices/{{invoice_id}}" }
        },
        {
          "name": "List Invoices",
          "request": { "method": "GET", "url": "{{paypal_base_url}}/v2/invoicing/invoices?page=1&page_size=20&total_required=true" }
        },
        {
          "name": "Send Reminder",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paypal_base_url}}/v2/invoicing/invoices/{{invoice_id}}/remind",
            "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Payment Reminder\",\n  \"note\": \"Your invoice is due soon.\",\n  \"send_to_invoicer\": true\n}" }
          }
        },
        {
          "name": "Record Partial Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paypal_base_url}}/v2/invoicing/invoices/{{invoice_id}}/payments",
            "body": { "mode": "raw", "raw": "{\n  \"method\": \"PAYPAL\",\n  \"payment_date\": \"2026-11-07\",\n  \"amount\": { \"currency_code\": \"USD\", \"value\": \"4100.00\" },\n  \"note\": \"Installment 1 of 2\"\n}" }
          }
        },
        {
          "name": "Cancel Invoice",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paypal_base_url}}/v2/invoicing/invoices/{{invoice_id}}/cancel",
            "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Invoice Cancelled\",\n  \"note\": \"Cancelled by agreement.\",\n  \"send_to_invoicer\": true,\n  \"send_to_recipient\": true\n}" }
          }
        }
      ]
    }
  ]
}
